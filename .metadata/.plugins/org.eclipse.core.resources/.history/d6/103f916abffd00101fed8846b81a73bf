import java.util.Arrays;
import java.util.List;
import java.util.stream.IntStream;

public class Test {
	public static void main(String[] args) {

		List<Integer> l = Arrays.asList(1, 2,5,11, 3, 4, 12, 56, 15, 4);
		l.stream().filter(n->isprime(n)).forEach(System.out::println);
		l.stream().filter(n->IntStream.rangeClosed(2,(int) Math.sqrt(n)).noneMatch(i->n%i==0)).forEach(System.out::println);
		
		
	}
	static boolean isprime(int n){
		
		for(int i=2;i<=n/2;i++) {
			if(n%i==0) {
				return false;
			}
		}
		return true;
		
	}

}
