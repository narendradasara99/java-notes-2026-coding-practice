package com.DefaultmethodsInInterface;

import java.util.ArrayList;
import java.util.Arrays;

public class Test {
	public static void main(String[] args) {

		ArrayList<Integer> a = new ArrayList<>();
		a.add(1);
		a.add(9);
		a.add(11);
		a.add(5);
		a.stream().map(l -> l * 2).forEach(p -> System.out.println(p));

		ArrayList<Object> ar = new ArrayList<>();

		ar.add(Arrays.asList(1, 2));
		ar.add(Arrays.asList(2, 5, 7, 8));
		
		ar.stream().map(a->a*10).forEach(System.out::println);

	}
}