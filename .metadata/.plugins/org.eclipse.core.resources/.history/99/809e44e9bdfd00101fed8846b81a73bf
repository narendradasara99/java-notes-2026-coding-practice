import java.util.Arrays;
import java.util.List;

public class Test {
	public static void main(String[] args) {

		List<Integer> l = Arrays.asList(1, 2, 3, 4, 12, 56, 15, 4);
		l.stream().filter(n->isprime(n)).forEach(System.out::println);
		
		
		
	}
	static boolean isprime(int n){
		
		for(int i=0;i>n/2;i++) {
			if(n%2==0) {
				return true;
			}
		}
		return false;
		
	}

}
