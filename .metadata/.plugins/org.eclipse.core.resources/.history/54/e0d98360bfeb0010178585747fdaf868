package com.DefaultmethodsInInterface;

import java.util.ArrayList;
import java.util.Arrays;
import java.util.List;
import java.util.stream.Collectors;
import java.util.stream.Stream;

public class Test {
	public static void main(String[] args) {

		ArrayList<Integer> a = new ArrayList<>();
		a.add(1);
		a.add(9);
		a.add(11);
		a.add(5);
		Stream<Integer> map = a.stream().map(l -> l * 2);

		ArrayList<List<Integer>> ar = new ArrayList<>();

		ar.add(Arrays.asList(1, 2));
		ar.add(Arrays.asList(2, 5, 7, 8));
		
		List<Integer> c = ar.stream().flatMap(m->m.stream()).collect(Collectors.toList());
		System.out.println(c);
	}
}